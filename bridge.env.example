# Use absolute paths. systemd does not expand $HOME in EnvironmentFile values.
UV_BIN=/home/USER/.local/bin/uv
BRIDGE_DIR=/home/USER/Progs/vocalinux-transcribe-cpp-bridge
PYTHONPATH=/home/USER/Progs/transcribe.cpp/bindings/python/src
TRANSCRIBE_LIBRARY=/home/USER/Progs/transcribe.cpp/build-vulkan/src/libtranscribe.so
TRANSCRIBE_MODEL=/home/USER/.cache/huggingface/hub/models--ORG--MODEL/snapshots/REVISION/model.gguf

TRANSCRIBE_BACKEND=vulkan
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_MAX_UPLOAD_BYTES=2097152
# BRIDGE_API_KEY=change-me
